# 客户端配置。
ENDPOINT=vpn.example.com
CLIENT_PORT=21194
CLIENT_PROTO=udp4
CLIENT_DEV=tun-ovpn
CLIENT_VERB=3

# 服务端配置。
SERVER_PORT=21194
SERVER=10.8.0.0 255.255.255.0
SERVER_PROTO=udp4
SERVER_DEV=tun-ovpn
SERVER_VERB=3
KEEPALIVE=10 120
MAX_CLIENTS=100

# 公共配置。
DATA_CIPHERS=AES-256-GCM:AES-128-GCM
AUTH_DIGEST=SHA256
